# load-balance 实例模板
# 需要把 usa1/usa2 改成实际已有实例名，把 relay 改成目标 xray inbound name。
# 快速定位：
# - 搜索【必改】：部署前必须替换的 ref、password、secret 等占位值。
# - 搜索【按需改】：端口、监听地址、user、remark、健康检查参数等常见部署参数。
# - 搜索【一般不改】：默认结构配置，除非明确调整生成逻辑。
# - 搜索【被引用】：其他配置会引用的名称，改名需同步修改引用方。

# 【按需改】stack 名称；add 时会被替换为用户输入的实例名。
name: auto-balance
# 【一般不改】是否启用该 stack；false 时不会生成或管理对应服务。
enabled: true
# 【一般不改】stack 角色标记；支持全集：edge、auto；auto 表示聚合或自动选择节点实例。
role: auto
# 【按需改】自定义标签列表；这里标记为自动代理类实例。
labels: [auto]

# Xray/xray 侧配置，用于暴露负载均衡后的入站入口。
xray:
  # 【一般不改】是否为该 stack 启用 xray 服务。
  enabled: true
  # 【按需改】stack 级 Xray 日志级别；不填继承 defaults.xray.loglevel。支持全集：debug、info、warning、error、none。
  # loglevel: warning

{{ stackSnippet "xray.api.default" 2 }}

{{ stackSnippet "xray.stats.enabled" 2 }}

{{ stackSnippet "xray.policy.enabled" 2 }}

  # xray 入站列表，会生成对应 Xray inbound。
  inbounds:
{{ stackSnippet "xray.inbound.socks5" 4 }}

{{ stackSnippet "xray.inbound.vmess-raw" 4 }}

  # 【一般不改】xray 出站配置，决定入站流量转发到哪里。
  # 下方方案只保留一种：默认方案 A 走本 stack 的 Clash；改用其他方案时同步删除或注释不适用字段。
{{ stackSnippet "xray.outbound.clash" 2 }}

# Clash/mihomo 侧配置，用于在多个上游之间负载均衡。
clash:
  # 【一般不改】是否为该 stack 启用 Clash 服务。
  # 如果 xray.outbound.type 不使用 clash，可以设为 false，不生成或管理 Clash 服务；但当前 stack 模型仍要求保留合法 clash 配置段。
  enabled: true
  # 【按需改】Clash 运行模式；支持全集：Rule、Global、Direct；Rule 表示按规则分流。
  mode: Rule
  # 【按需改】stack 级 mihomo/clash 日志级别；不填继承 defaults.clash.loglevel。支持全集：debug、info、warning、error、silent。
  # loglevel: info

{{ stackSnippet "clash.controller.default" 2 }}

  # Clash 本地监听器配置。
  listeners:
    # socks 监听器列表，供 xray 或本机连接。
    socks:
{{ stackSnippet "clash.listener.socks" 6 }}
    # HTTP 监听器列表，供本机 HTTP 代理客户端连接。
    http:
{{ stackSnippet "clash.listener.http" 6 }}

  # Clash 上游代理列表。
  upstreams:
{{ stackMemberSnippet "clash.upstream.xray-socks5" "usa1" 4 }}

{{ stackMemberSnippet "clash.upstream.xray-socks5" "usa2" 4 }}

  # Clash 代理组列表。
  groups:
{{ stackSnippet "clash.group.load-balance" 4 }}

{{ stackSnippet "clash.group.select" 4 }}

  # Clash 规则集选择。
  rules:
    # 内置规则 profile 名称；支持全集：default；default 表示使用默认分流规则。
    profile: default
