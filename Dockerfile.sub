FROM golang:1.25-alpine AS builder

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY cmd ./cmd
COPY internal ./internal
COPY templates ./templates

RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/proxystack-sub ./cmd/ps-sub

FROM alpine:3.22

RUN addgroup -S -g 10001 proxystack \
	&& adduser -S -D -H -u 10001 -G proxystack -s /sbin/nologin proxystack \
	&& apk add --no-cache ca-certificates wget

COPY --from=builder /out/proxystack-sub /usr/local/bin/proxystack-sub

USER 10001:10001
WORKDIR /data

EXPOSE 3003
VOLUME ["/data"]

HEALTHCHECK --interval=30s --timeout=3s --retries=3 CMD wget -qO- http://127.0.0.1:3003/health >/dev/null

CMD ["proxystack-sub", "--base-dir", "/data", "serve"]
