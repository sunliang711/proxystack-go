# HTTP inbound：公开发布时必须使用 password 认证。
# HTTP inbound 不支持 udp 字段。
- name: http
  protocol: http
  listen: 0.0.0.0
  port: 24001
  # auth 是 HTTP 代理的实际连接账号；不会从 config.yaml users 自动读取。
  # user_refs 只决定订阅归属和节点名。
  auth:
    type: password
    username: http-user
    password: change-me-http-password
  # 【按需改】订阅展示名模板；支持 .stack/.inbound/.protocol/.port/.user/.profile/.remark。
  # display_template: '{{ "{{" }} .stack {{ "}}" }} {{ "{{" }} .inbound {{ "}}" }} {{ "{{" }} .protocol {{ "}}" }} {{ "{{" }} .remark {{ "}}" }}'
  region: US
  sub: true
  user_refs:
    - user: user1
      profile: default
      remark: {{ .StackName }} http
